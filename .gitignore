/vendor/
node_modules/
npm-debug.log
yarn-error.log

# Laravel 4 specific
bootstrap/compiled.php
app/storage/

# Laravel 5 & Lumen specific
public/storage
public/hot

# Laravel 5 & Lumen specific with changed public path
public_html/storage
public_html/hot

storage/*.key
.env
Homestead.yaml
Homestead.json
/.vagrant
.phpunit.result.cache
/.idea/*

# Laravel caches generated by `artisan` / `composer install`. They are machine
# specific: shipping them makes a deploy boot with stale package manifests.
/bootstrap/cache/*.php

# NOTE: /storage/installed is intentionally tracked. The installer package
# redirects every web request to /install while this marker is missing, and a
# fresh deploy without it takes the whole dashboard down.

#/.phpstorm.meta.php
#/_ide_helper.php
#/_ide_helper_models.php
.vscode
/qodana.yaml
/public/firebase-messaging-sw.js
/storage/app/firebase_service.json
/app/Swagger/*.php

# composer.lock is intentionally tracked: without it `composer install` on the
# server resolves the caret ranges fresh and ships different package versions
# than local (this is what broke dacoto/laravel-wizard-installer -> route
# "install.server" not defined).

# macOS hidden files
.DS_Store
#other
.cspell
.claude
/app/Modules/
